{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "scripts/**/*.ts",
      "tests/**/*.ts",
      "package.json",
      "tsconfig.json",
      "biome.json",
      "vite.config.ts",
      "vitest.config.ts",
      "playwright.config.ts"
    ],
    "ignore": [
      "node_modules",
      "dist",
      "src/generated",
      "schemas",
      "assets",
      "content",
      "playwright-report",
      "test-results",
      "coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
