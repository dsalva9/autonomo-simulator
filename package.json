{
  "name": "autonomo-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first satirical survival simulator about self-employment in Spain.",
  "scripts": {
    "dev": "tsx scripts/compile-content.ts && vite",
    "prebuild": "tsx scripts/compile-content.ts",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "schema:emit": "tsx scripts/emit-schemas.ts",
    "schema:check": "tsx scripts/emit-schemas.ts --check",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "compile:content": "tsx scripts/compile-content.ts",
    "build:content": "tsx scripts/compile-content.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:sim": "vitest run tests/simulation",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "verify": "pnpm schema:check && pnpm validate:assets && pnpm validate:content && pnpm compile:content && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "lucide-react": ">=0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.7.0"
  }
}
