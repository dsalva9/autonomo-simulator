# Optional privacy-first, cookieless analytics via Umami Cloud (free tier: 100k events/mo, no cookie banner needed).
# Leave empty locally or for itch.io builds to disable analytics completely.
# To enable in production: create a free site at https://cloud.umami.is/ for autonomo-simulator.com,
# copy the Website ID, and add VITE_UMAMI_WEBSITE_ID in Vercel -> Project Settings -> Environment Variables.
VITE_UMAMI_WEBSITE_ID=

# Optional override if using a self-hosted Umami instance (defaults to https://cloud.umami.is/script.js).
# VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
